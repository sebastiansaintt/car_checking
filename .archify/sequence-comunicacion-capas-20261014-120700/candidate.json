  "cards": [
    {
      "dot": "emerald",
      "title": "Aislamiento Estricto de Capas",
      "items": [
        "Los Routers solo validan DTOs de entrada y salida, sin contener lógica de negocio.",
        "Los Servicios coordinan validaciones, reglas de negocio y cálculo de dictamen.",
        "Los Repositorios encapsulan las consultas a base de datos mediante SQLAlchemy."
      ]
    },
    {
      "dot": "rose",
      "title": "Seguridad e Idempotencia",
      "items": [
        "La autenticación se inyecta mediante Depends() antes de alcanzar la capa de servicios.",
        "Redis valida estado de revocación del token y previene doble sumisión con Idempotency-Keys."
      ]
    },
    {
      "dot": "cyan",
      "title": "Resiliencia Offline-First",
      "items": [
        "En caso de falla de conectividad en campo, el Service Worker encola en IndexedDB.",
        "Al restablecerse la red, se dispara la sincronización automática con reintentos seguros."
      ]
    }
  ]
