# ============================================
# CarChecking — Variables de Entorno
# ============================================
# Copiar este archivo como .env y completar con valores reales.
# NUNCA commitear el archivo .env real.

# --- Base de Datos (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=           # Generar: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_DB=car_checking
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# --- Redis ---
REDIS_PASSWORD=              # Generar: python -c "import secrets; print(secrets.token_urlsafe(24))"
REDIS_URL=redis://default:${REDIS_PASSWORD}@redis:6379/0

# --- Upstash Redis (producción) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Seguridad ---
SECRET_KEY=                  # Generar: python -c "import secrets; print(secrets.token_hex(32))"
ENVIRONMENT=development

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Seed de usuarios (solo para sembrado inicial) ---
SEED_INSPECTOR_PW=           # Generar contraseñas seguras para cada usuario
SEED_INGENIERO_PW=
SEED_PROGRAMADOR_PW=
SEED_ADMIN_PW=
